# .env.example — copier en .env et remplir les valeurs
# ⚠️ Ne JAMAIS committer le .env réel sur GitHub !

# MongoDB
MONGO_USER=admin
MONGO_PASSWORD=change_me_strong_password
MONGO_DB=appclasses
MONGO_URI=mongodb://admin:change_me_strong_password@mongo:27017/appclasses?authSource=admin

# API
API_URL=http://localhost:3000
SESSION_SECRET=change_me_with_a_long_random_string
FRONT_URL=http://localhost

# Admin initial
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_password
