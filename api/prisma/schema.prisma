generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  Administrateur
  Editeur
  Lecteur
}

model Class {
  id        String   @id @map("_id") @default(auto()) @db.ObjectId
  name      String
  teacher   String?
  students  String[]
  createdAt DateTime @default(now())
}

model User {
  id        String   @id @map("_id") @default(auto()) @db.ObjectId
  username  String   @unique
  password  String
  role      UserRole @default(Lecteur)
  createdAt DateTime @default(now())
}
